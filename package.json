{
  "name": "synapsestate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Incident-safety and lifecycle governance layer for OpenFeature",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && vitest run test/drills",
    "test:e2e": "pnpm --filter @synapsestate/dashboard test:e2e",
    "test:coverage": "vitest run --coverage",
    "test:drills": "vitest run test/drills",
    "test:mutation": "pnpm --filter @synapsestate/lease run test:mutation && pnpm --filter @synapsestate/sdk run test:mutation",
    "test:mutation:fast": "pnpm --filter @synapsestate/lease run test:mutation:fast && pnpm --filter @synapsestate/sdk run test:mutation:fast",
    "typecheck": "pnpm -r run typecheck && tsc -p load/tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "bench": "pnpm --filter @synapsestate/sdk run bench",
    "test:load": "k6 run -e PROFILE=smoke -e DURATION=10s load/k6/mixed-stress.js",
    "test:load:long-polling": "k6 run load/k6/long-polling.js",
    "test:load:telemetry": "k6 run load/k6/telemetry.js",
    "test:load:stress": "k6 run -e PROFILE=stress load/k6/mixed-stress.js",
    "test:load:soak": "k6 run -e PROFILE=soak load/k6/mixed-stress.js",
    "test:load:story-arc": "k6 run load/k6/story-arc.js",
    "test:load:mock": "tsx load/k6/mock-server.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yaml}\""
  },
  "devDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.20.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
