{
  "name": "synapsestate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Incident-safety and lifecycle governance layer for OpenFeature",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r run typecheck",
    "bench": "pnpm --filter @synapsestate/sdk run bench",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,json,md,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.20.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
