.terraform.lock.hcl
charts/*/charts/
charts/*/tmp/

# Testing & Coverage Artifacts
coverage/
coverage.txt
coverage.html
*.lcov
scratch/
tmp/
.temp/
playwright-report/
test-results/
.stryker-tmp/
reports/

# Environment and Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
kubeconfig*
