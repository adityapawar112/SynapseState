          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(synapse_state_poll_duration_seconds_bucket[5m])) by (le, status_code))",
          "legendFormat": "HTTP {{status_code}} p95",
          "range": true,
          "refId": "B"
        }
      ],
