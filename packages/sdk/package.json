{
  "name": "@synapsestate/sdk",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "bench": "tsx benchmarks/run.ts",
    "bench:vitest": "vitest bench --run",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:mutation": "stryker run",
    "test:mutation:fast": "stryker run --since origin/main",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bench.json --noEmit"
  },
  "dependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@synapsestate/lease": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.13.0",
    "tinybench": "^6.2.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
